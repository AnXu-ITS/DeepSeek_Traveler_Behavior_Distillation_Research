{
  "schema_version": "1.0",
  "frozen_source": "src/traveler_distillation/student/features.py (FeatureExtractor.encode)",
  "persona_features": {
    "categorical": [
      "age_group",
      "income_group",
      "occupation",
      "habitual_mode",
      "schedule_flexibility",
      "mobility_limitation"
    ],
    "numeric": [
      "household_size",
      "has_children",
      "car_ownership",
      "driving_license",
      "bike_ownership",
      "transit_pass"
    ]
  },
  "trip_features": {
    "categorical": [
      "purpose",
      "time_constraint"
    ],
    "numeric": [
      "distance_km",
      "desired_departure_min",
      "desired_arrival_min"
    ]
  },
  "dynamic_context": {
    "categorical": [
      "weather_condition"
    ],
    "numeric": [
      "weather_intensity",
      "road_congestion",
      "transit_delay_min",
      "transit_disruption",
      "road_disruption",
      "fare_multiplier",
      "parking_cost_multiplier",
      "congestion_charge"
    ]
  },
  "mode_level_attributes": [
    "travel_time_min",
    "monetary_cost",
    "access_time_min",
    "transfers",
    "reliability_delay_min",
    "weather_exposure"
  ],
  "availability_representation": {
    "choice_set_encoding": "state.alternatives list order preserved; each mode -> mode_vocab index",
    "mask_convention": "alt_mask float tensor: 1.0 = available, 0.0 = unavailable/padded",
    "unavailable_mode_behavior": "masked alternatives receive -inf logits in masked_softmax -> zero probability mass"
  },
  "encoding": {
    "categorical": "learned embedding; vocab index per field; <UNK> fallback = index 0",
    "numeric": "z-score using per-field mean/std fit on the S7 TRAIN split only"
  },
  "tensor_layout": {
    "global_cat": {
      "dtype": "long",
      "n": 9,
      "order": [
        "age_group",
        "income_group",
        "occupation",
        "habitual_mode",
        "schedule_flexibility",
        "mobility_limitation",
        "purpose",
        "time_constraint",
        "weather_condition"
      ]
    },
    "global_num": {
      "dtype": "float32",
      "n": 17,
      "order": [
        "household_size",
        "has_children",
        "car_ownership",
        "driving_license",
        "bike_ownership",
        "transit_pass",
        "distance_km",
        "desired_departure_min",
        "desired_arrival_min",
        "weather_intensity",
        "road_congestion",
        "transit_delay_min",
        "transit_disruption",
        "road_disruption",
        "fare_multiplier",
        "parking_cost_multiplier",
        "congestion_charge"
      ]
    },
    "alt_mode_idx": {
      "dtype": "long",
      "per_alternative": "mode_vocab index"
    },
    "alt_num": {
      "dtype": "float32",
      "n_per_alternative": 6,
      "order": [
        "travel_time_min",
        "monetary_cost",
        "access_time_min",
        "transfers",
        "reliability_delay_min",
        "weather_exposure"
      ]
    },
    "alt_mask": {
      "dtype": "float32",
      "per_alternative": "1.0/0.0 availability"
    }
  },
  "vocabularies": {
    "mode_vocab": {
      "<UNK>": 0,
      "bike": 1,
      "car": 2,
      "pt": 3,
      "walk": 4
    },
    "cat_vocab_sizes": {
      "age_group": 6,
      "income_group": 4,
      "occupation": 8,
      "habitual_mode": 6,
      "schedule_flexibility": 4,
      "mobility_limitation": 4,
      "purpose": 3,
      "time_constraint": 3,
      "weather_condition": 3
    }
  }
}
